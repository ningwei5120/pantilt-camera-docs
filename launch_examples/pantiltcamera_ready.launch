<launch>
    <!-- ============================================================ -->
    <!-- 云台相机就绪启动文件 (pantiltcamera_ready.launch)             -->
    <!-- ============================================================ -->
    <!-- 功能: 启动相机 + 云台 + 图像处理，自动回正并自检             -->
    <!-- 节点命名空间固定为 pantilt_demo / cv_camera_demo，            -->
    <!-- 方便配合 pantilt_tool.py 使用                                 -->
    <!-- ============================================================ -->

    <!-- 设备参数 -->
    <arg name="device_path" default=""
         doc="摄像头设备路径，留空或传 AUTO 则自动检测 /dev/v4l/by-path"/>
    <arg name="port_name" default=""
         doc="云台串口路径，留空或传 AUTO 则自动探测"/>
    <arg name="camera_info_url" default="file://$(find cv_camera)/calibrationdata/1920x1080.yaml"
         doc="相机标定文件路径"/>
    <arg name="image_width" default="1920" doc="图像宽度"/>
    <arg name="image_height" default="1080" doc="图像高度"/>
    <arg name="rate" default="30" doc="图像发布频率"/>

    <!-- 可选功能 -->
    <arg name="use_rviz" default="false" doc="是否启动RViz"/>
    <arg name="use_image_view" default="false" doc="是否启动image_view显示图像"/>

    <!-- 自检参数 -->
    <arg name="timeout" default="15.0" doc="自检等待超时(秒)"/>
    <arg name="center_timeout" default="20.0" doc="回正等待超时(秒)"/>
    <arg name="tolerance" default="2.0" doc="回正角度容差(°)"/>
    <arg name="skip_center_wait" default="false" doc="是否跳过等待回正到位"/>

    <!-- ========================================= -->
    <!-- 1. 相机节点                               -->
    <!-- ========================================= -->
    <node pkg="cv_camera" type="cv_camera_node" name="cv_camera_demo" output="screen"
          launch-prefix="$(find pantilt_camera_serial)/scripts/filter_jpeg.sh">
        <param name="device_path" command="$(find pantilt_camera_serial)/scripts/resolve_device_path.py '$(arg device_path)'" />
        <param name="image_width" value="$(arg image_width)" />
        <param name="image_height" value="$(arg image_height)" />
        <param name="rate" value="$(arg rate)"/>
        <param name="camera_info_url" value="$(arg camera_info_url)"/>
        <param name="frame_id" value="camera_demo_link"/>
    </node>

    <!-- ========================================= -->
    <!-- 2. 图像处理节点 - 畸变矫正                -->
    <!-- ========================================= -->
    <node name="image_proc_demo" pkg="image_proc" type="image_proc" respawn="false" output="screen">
        <remap from="image_raw" to="/cv_camera_demo/image_raw"/>
        <remap from="camera_info" to="/cv_camera_demo/camera_info"/>
    </node>

    <!-- ========================================= -->
    <!-- 3. 云台串口控制节点                       -->
    <!-- ========================================= -->
    <node pkg="pantilt_camera_serial" type="pantilt_camera_serial"
          name="pantilt_demo" output="screen" required="true">
        <param name="port_name" command="$(find pantilt_camera_serial)/scripts/resolve_serial_port.py '$(arg port_name)'" />
        <param name="baud_rate" value="115200" />
        <param name="query_rate" value="10" />
    </node>

    <!-- ========================================= -->
    <!-- 4. 自检与回正初始化节点                   -->
    <!-- ========================================= -->
    <node pkg="pantilt_camera_serial" type="pantilt_init_check.py"
          name="pantilt_init_check" output="screen">
        <param name="camera_topic" value="/cv_camera_demo/image_raw"/>
        <param name="angle_topic" value="/pantilt_demo/pantilt_angle_info"/>
        <param name="command_service" value="/pantilt_demo/send_command"/>
        <param name="timeout" value="$(arg timeout)"/>
        <param name="center_timeout" value="$(arg center_timeout)"/>
        <param name="tolerance" value="$(arg tolerance)"/>
        <param name="skip_center_wait" value="$(arg skip_center_wait)"/>
    </node>

    <!-- ========================================= -->
    <!-- 5. 图像可视化 (可选)                      -->
    <!-- ========================================= -->
    <group if="$(arg use_image_view)">
        <node name="image_view_raw" pkg="image_view" type="image_view" output="screen">
            <remap from="image" to="/cv_camera_demo/image_raw"/>
            <param name="window_name" value="原始图像"/>
        </node>

        <node name="image_view_rect" pkg="image_view" type="image_view" output="screen">
            <remap from="image" to="/cv_camera_demo/image_rect_color"/>
            <param name="window_name" value="矫正后图像"/>
        </node>
    </group>

    <!-- ========================================= -->
    <!-- 6. RViz可视化界面 (可选)                  -->
    <!-- ========================================= -->
    <group if="$(arg use_rviz)">
        <node name="rviz" pkg="rviz" type="rviz"
              args="-d $(find pantilt_camera_serial)/rviz/singleCamera.rviz"
              required="false" output="screen"/>
    </group>

    <!-- ========================================= -->
    <!-- 7. 静态TF发布 (相机坐标系)                -->
    <!-- ========================================= -->
    <node pkg="tf2_ros" type="static_transform_publisher" name="camera_tf"
          args="0 0 0 0 0 0 map camera_demo_link" />

</launch>
