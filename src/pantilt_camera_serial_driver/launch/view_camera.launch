<launch>
    <!-- 查看指定摄像头视频 -->
    <arg name="device" default="/dev/video2" doc="摄像头设备路径"/>
    <arg name="width" default="640" doc="宽度"/>
    <arg name="height" default="480" doc="高度"/>
    
    <!-- 相机节点 -->
    <node pkg="cv_camera" type="cv_camera_node" name="view_camera" output="screen">
        <param name="device_path" value="$(arg device)" />
        <param name="image_width" value="$(arg width)" />
        <param name="image_height" value="$(arg height)" />
        <param name="rate" value="30"/>
    </node>
    
    <!-- 图像显示 -->
    <node name="image_view" pkg="image_view" type="image_view" output="screen">
        <remap from="image" to="/view_camera/image_raw"/>
        <param name="window_name" value="Camera: $(arg device)"/>
    </node>
</launch>
