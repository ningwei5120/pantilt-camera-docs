<launch>
    <!-- 相机单独测试 launch 文件 -->
    <!-- 用于验证摄像头是否正常工作，不依赖云台硬件 -->
    
    <!-- 参数配置 -->
    <arg name="device_path" default="/dev/video2" 
         doc="摄像头设备路径，Wasintek相机通常是 /dev/video2"/>
    <arg name="camera_info_url" default="file://$(find cv_camera)/calibrationdata/1920x1080.yaml"
         doc="相机标定文件路径"/>
    <arg name="image_width" default="1920" doc="图像宽度"/>
    <arg name="image_height" default="1080" doc="图像高度"/>
    <arg name="rate" default="30" doc="图像发布频率"/>
    
    <!-- 相机节点 -->
    <node pkg="cv_camera" type="cv_camera_node" name="cv_camera_test" output="screen">
        <param name="device_path" value="$(arg device_path)" />
        <param name="image_width" value="$(arg image_width)" />
        <param name="image_height" value="$(arg image_height)" />
        <param name="rate" value="$(arg rate)"/>
        <param name="camera_info_url" value="$(arg camera_info_url)"/>
        <param name="frame_id" value="camera_test_link"/>
    </node>

    <!-- 图像处理节点 - 畸变矫正 -->
    <node name="image_proc" pkg="image_proc" type="image_proc" respawn="false" output="screen">
        <remap from="image_raw" to="/cv_camera_test/image_raw"/>
        <remap from="camera_info" to="/cv_camera_test/camera_info"/>
        <remap from="image_rect_color" to="/cv_camera_test/image_rect_color"/>
    </node>

    <!-- 图像查看节点 -->
    <node name="image_view_raw" pkg="image_view" type="image_view" output="screen">
        <remap from="image" to="/cv_camera_test/image_raw"/>
        <param name="window_name" value="原始图像"/>
    </node>
    
    <node name="image_view_rect" pkg="image_view" type="image_view" output="screen">
        <remap from="image" to="/cv_camera_test/image_rect_color"/>
        <param name="window_name" value="矫正后图像"/>
    </node>

    <!-- 打印测试信息 -->
    <node pkg="rostopic" type="rostopic" name="camera_info_echo" 
          args="echo /cv_camera_test/camera_info" output="screen"/>

</launch>
