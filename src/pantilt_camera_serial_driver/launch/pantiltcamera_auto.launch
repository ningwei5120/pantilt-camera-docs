<launch>
    <!-- ============================================================ -->
    <!-- Autolabor C1 云台相机 Launch 文件 - 自动设备检测版 -->
    <!-- ============================================================ -->
    <!-- 使用方法: -->
    <!--   1. 先运行 ls /dev/video* 查看可用设备 -->
    <!--   2. 根据设备号选择设备路径 -->
    <!-- ============================================================ -->
    
    <!-- 设备路径选择 - 根据实际设备修改 -->
    <!-- 常见设备路径: -->
    <!--   /dev/video0  - 内置摄像头 -->
    <!--   /dev/video2  - 外接USB相机 (如 Wasintek) -->
    <arg name="device_path" default="/dev/video2" 
         doc="摄像头设备路径，可选: /dev/video0, /dev/video2, /dev/v4l/by-path/..."/>
    
    <arg name="port_name" default="/dev/ttyUSB0" 
         doc="云台串口路径"/>
    <arg name="camera_info_url" default="file://$(find cv_camera)/calibrationdata/1920x1080.yaml"
         doc="相机标定文件路径"/>
    <arg name="image_width" default="1920" doc="图像宽度"/>
    <arg name="image_height" default="1080" doc="图像高度"/>
    <arg name="rate" default="30" doc="图像发布频率"/>
    
    <!-- 相机节点 -->
    <node pkg="cv_camera" type="cv_camera_node" name="cv_camera0" output="screen">
        <param name="device_path" value="$(arg device_path)" />
        <param name="image_width" value="$(arg image_width)" />
        <param name="image_height" value="$(arg image_height)" />
        <param name="rate" value="$(arg rate)"/>
        <param name="camera_info_url" value="$(arg camera_info_url)"/>
        <param name="frame_id" value="camera_link"/>
    </node>

    <!-- 图像处理节点 - 畸变矫正 -->
    <node name="image_proc" pkg="image_proc" type="image_proc" respawn="false" output="screen">
        <remap from="image_raw" to="/cv_camera0/image_raw"/>
        <remap from="camera_info" to="/cv_camera0/camera_info"/>
    </node>

    <!-- 云台串口控制节点 -->
    <node pkg="pantilt_camera_serial" type="pantilt_camera_serial" name="pantilt_camera_serial0" output="screen">
        <param name="port_name" value="$(arg port_name)" />
        <param name="baud_rate" value="115200" />
        <param name="query_rate" value="10" />
    </node>

    <!-- RViz可视化界面 -->
    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find pantilt_camera_serial)/rviz/singleCamera.rviz" required="true"/>

</launch>
