<launch>
    <node pkg="cv_camera" type="cv_camera_node" name="camera" output="screen">
        <param name="flip_image" value="false" />
        <param name="device_path" value="/dev/v4l/by-path/platform-3610000.xhci-usb-0:2.3.4.4:1.0-video-index0" />
        <param name="image_width" value="1280" />
        <param name="image_height" value="720" />
        <param name="rate" value="30"/>
        <param name="camera_info_url" value="file://$(find cv_camera)/calibrationdata/1280x720.yaml"/>
        <param name="rescale_camera_info" value="false"/>
    </node>

    <!-- 图像处理节点，进行畸变矫正 -->
    <node name="image_proc" pkg="image_proc" type="image_proc" respawn="false">
        <remap from="image_raw" to="/camera/image_raw"/>
        <remap from="camera_info" to="/camera/camera_info"/>
        <remap from="image_rect_color" to="/camera/image_rect_color"/>
    </node>

    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find cv_camera)/rviz/single_rect_display.rviz" required ="true"/>

</launch>